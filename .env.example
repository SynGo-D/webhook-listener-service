NODE_ENV=development
PORT=5002

# -----------------------------------------------------------------------
# Database (see docker-compose.yml — mapped to host port 5433 so it can
# run alongside integration-service's native Postgres on 5432)
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=webhook_listener_db
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------
# RabbitMQ (see docker-compose.yml)
# -----------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -----------------------------------------------------------------------
# Provider webhook secrets (must match what's configured on the GitHub/
# GitLab webhook itself)
# -----------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=dev-github-secret
GITLAB_WEBHOOK_SECRET=dev-gitlab-secret
