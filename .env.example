NODE_ENV=development
PORT=5002

# -----------------------------------------------------------------------
# Database (see docker-compose.yml — mapped to host port 5433 so it can
# run alongside integration-service's native Postgres on 5432)
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=webhook_listener_db
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------
# RabbitMQ (see docker-compose.yml)
# -----------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -----------------------------------------------------------------------
# Webhook secrets lookup
# Each connected repository has its own webhook secret, stored by
# integration-service. This service fetches it over an internal endpoint.
# INTERNAL_SERVICE_TOKEN must be the same value in both services. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------
INTEGRATION_SERVICE_URL=http://localhost:5001
INTERNAL_SERVICE_TOKEN=YOUR_INTERNAL_SERVICE_TOKEN

# How long duplicate-delivery records are kept before the hourly purge.
DEDUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------
# LEGACY shared webhook secrets
# Used only for repositories connected before per-integration secrets
# existed. Leave empty on a fresh install; clear them once every older
# integration has been reconnected.
# -----------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
