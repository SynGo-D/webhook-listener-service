NODE_ENV=development
PORT=5002

# -----------------------------------------------------------------------
# Database (see docker-compose.yml — mapped to host port 5433 so it can
# run alongside integration-service's native Postgres on 5432)
# -----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=webhook_listener_db
DB_USER=postgres
DB_PASSWORD=postgres

# -----------------------------------------------------------------------
# RabbitMQ (see docker-compose.yml)
# -----------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# -----------------------------------------------------------------------
# Webhook signature verification
# Must exactly match the secret/token entered in each provider's webhook
# settings UI. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------
GITHUB_WEBHOOK_SECRET=YOUR_GITHUB_WEBHOOK_SECRET
GITLAB_WEBHOOK_SECRET=YOUR_GITLAB_WEBHOOK_SECRET
